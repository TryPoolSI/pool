# syntax=docker/dockerfile:1
FROM node:24.22.1-bookworm-slim AS dependencies
WORKDIR /app
ENV EXPO_NO_TELEMETRY=1 EXPO_NO_DOTENV=1
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS development
ENV NODE_ENV=development
COPY . .
EXPOSE 3000
CMD ["npx", "expo", "start", "--web", "--port", "3000", "--host", "lan"]

FROM dependencies AS build
# Vercel Git builds do not forward project environment variables as build
# arguments, so default to the production Supabase project. Both values are
# public client configuration that ships in the web bundle; access is enforced
# by row-level security. Pass --build-arg to override (CI smoke does).
ARG EXPO_PUBLIC_SUPABASE_URL=https://eeldfdmouvchfjgzbbmb.supabase.co
ARG EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mhB40AE5q_VAwGh-4Je3EQ_bvFGXKQf
ENV NODE_ENV=production
COPY . .
RUN test -n "$EXPO_PUBLIC_SUPABASE_URL" && test -n "$EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY" && npm run build

FROM node:24.22.1-bookworm-slim AS production
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/scripts/serve.mjs ./scripts/serve.mjs
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD node -e "fetch('http://127.0.0.1:' + process.env.PORT + '/api/health').then(r => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1));"
CMD ["node", "scripts/serve.mjs"]
